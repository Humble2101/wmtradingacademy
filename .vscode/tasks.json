{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Install & Setup (first time)",
      "type": "shell",
      "command": "npm install && npm run db:setup",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "▶️  Start Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting",
          "endsPattern": "Ready in"
        }
      }
    },
    {
      "label": "🗄️  Open Prisma Studio",
      "type": "shell",
      "command": "npm run db:studio",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🌱 Re-seed Database",
      "type": "shell",
      "command": "npm run db:seed",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🔄 Reset & Re-seed Database",
      "type": "shell",
      "command": "npm run db:reset",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
